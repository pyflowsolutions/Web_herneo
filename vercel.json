{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["backend/**", "frontend/**"]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/server.js" },
    { "src": "/login.html", "dest": "backend/server.js" },
    { "src": "/admin.html", "dest": "backend/server.js" },
    { "src": "/admin", "dest": "backend/server.js" },
    { "src": "/uploads/(.*)", "dest": "uploads/$1" },
    { "src": "/(.*)", "dest": "backend/server.js" }
  ]
}